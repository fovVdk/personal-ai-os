# Runtime configuration is loaded from environment variables; replace local defaults as needed.
# 程序从环境变量读取配置；请按实际环境替换本地开发默认值。
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8080
DATABASE_URL=postgres://paios:change-me@localhost:5432/paios?sslmode=disable
LOG_LEVEL=info
PAIOS_API_KEY=
MODEL_PROVIDER=mock
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=mock
OLLAMA_BASE_URL=http://localhost:11434
# These paths are reserved for future file storage and are not currently consumed by a storage adapter.
# 这些路径为未来文件存储预留，目前尚无存储适配器使用它们。
DATA_DIR=./data
FILE_STORAGE_DIR=./data/files
# Exact host allowlist for the optional read-only http.fetch Tool; empty disables it.
# 可选只读 http.fetch 工具的精确主机 allowlist；留空时不注册该工具。
HTTP_FETCH_ALLOWED_HOSTS=
# Operator-owned MCP server configuration as a strict JSON array; empty disables MCP.
# 由运维配置的 MCP Server 严格 JSON 数组；留空时不启动 MCP Server。
MCP_SERVERS_JSON=
# Supervisor turn budgets; zero cost means no configured currency cap.
# Supervisor 单轮预算；成本上限为零表示未配置货币成本限制。
MAX_AGENT_STEPS=12
MAX_MODEL_CALLS=8
MAX_MODEL_TOKENS=64000
MAX_TOOL_CALLS=20
MAX_EXECUTION_SECONDS=300
MAX_EXECUTION_COST=0
MAX_RETRIES=3
# Durable worker pool limits and lease/recovery cadence.
# 持久化 Worker Pool 的并发上限、租约与恢复扫描周期。
PAIOS_WORKER_ID=paios
PAIOS_WORKER_COUNT=2
PAIOS_WORKER_LEASE_SECONDS=30
PAIOS_WORKER_HEARTBEAT_SECONDS=10
PAIOS_WORKER_POLL_MILLISECONDS=500
PAIOS_WORKER_RECOVERY_SECONDS=5
SHUTDOWN_GRACE_SECONDS=15
# Agent retries after an uncertain in-flight result are disabled unless that Agent explicitly declares idempotency.
# 只有 Agent 显式声明幂等保证时，运行中结果不确定的执行才允许自动重试。
POSTGRES_PASSWORD=change-me
# These paths are relative to deployments/compose/docker-compose.yml; absolute SSD paths are also supported.
# 路径相对于 deployments/compose/docker-compose.yml；也可以配置外置 SSD 的绝对路径。
PAIOS_DATA_DIR=../../data/postgres
OLLAMA_DATA_DIR=../../data/ollama
